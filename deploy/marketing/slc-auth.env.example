# Render privately to /opt/slc-mcp/auth.env, mode 0600. Unique random token per seat.
# No legacy shared-token override. The server binds each bearer to its named seat.
SLC_MCP_SEAT_TOKENS={"overseer":"${SLC_OVERSEER_TOKEN}","writer":"${SLC_WRITER_TOKEN}","editor":"${SLC_EDITOR_TOKEN}","communicator":"${SLC_COMMUNICATOR_TOKEN}","librarian":"${SLC_LIBRARIAN_TOKEN}","thinker":"${SLC_THINKER_TOKEN}","designer":"${SLC_DESIGNER_TOKEN}","girl":"${SLC_GIRL_TOKEN}"}
