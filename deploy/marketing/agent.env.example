# Render separately per role, chmod 600; no shared role bearer token.
SWARM_ROLE=${ROLE}
SLC_MCP_URL=${SLC_MCP_URL}
SLC_SEAT_ID=${ROLE}
SEAT_ID=${ROLE}
# SLC_MCP_TOKEN is supplied ONLY by the role's separate slc.env (see slc.env.example).
# Provider keys belong in a separate root-protected provider.env, referenced by
# custom_providers[].key_env. Confirm the final provider variable with its owner.
